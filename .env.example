OPENAI_API_KEY=
OPENAI_MODEL_H=gpt-5-nano
OPENAI_MODEL_G=gpt-5-nano
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TIMEOUT_SECONDS=60
# Only used when integrating into the team project:
HG_REVIEW_MODE=mock
HG_SOURCES_FILE=
HG_REVIEW_OUTPUT_DIR=outputs/hg
# Optional absolute root for team-relative registry/output paths.
# HG_PROJECT_ROOT=/absolute/path/to/learngraph-multiagent
